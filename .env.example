# ── ipfs-gate-escrow .env — the money box's ONLY config ──────────────────────
# Copy to .env on the BOX HOST ONLY. This file is the single home of the escrow
# account's active key: it must never exist on the node host, in git, or in chat.
# Keep the host minimal, patched, and free of dev tooling (no Claude on the box).

# The escrow Hive account that RECEIVES payments and SENDS refunds (the same
# account the node's /reserve quotes name — IPFS_GATE_HIVE_ACCOUNT node-side).
ESCROW_ACCOUNT=

# ⚠ THE MONEY KEY — the escrow account's ACTIVE key (starts 5K/5J). The whole
# decoupling exists so this lives HERE and nowhere else. On the node host this
# var must be ABSENT (the node warns if it sees it in box mode).
IPFS_GATE_ACTIVE_KEY=

# Payment token. HBD/HIVE are native (precision 3). A Hive-Engine token (e.g.
# CNOOBS) REQUIRES the precision lock below — FATAL if missing. Over-precise →
# the chain rejects transfers; under-precise → funds round to 0 and strand.
ESCROW_CURRENCY=CNOOBS
ESCROW_TOKEN_PRECISION=3

# ⚠ FAIL-CLOSED TRUST: comma-separated 64-hex schnorr pubkeys of the gate-node
# reporting key(s) this box accepts reports from. The node logs its pubkey at
# first box-mode boot ("add to box's ESCROW_EXPECTED_REPORTERS"). Empty = the
# box refuses ALL reports. REQUIRED.
ESCROW_EXPECTED_REPORTERS=

# The Nostr relays carrying escrow-protocol/0.1 (kind-31337 event-reports in,
# settlement-receipts out). The box only ever connects OUTBOUND (WSS).
NOSTR_RELAYS=wss://nostr.v4call.com

# ── Box-authoritative settlement knobs ───────────────────────────────────────
# The node's quote-side env must be set to the SAME values (see the node's
# .env.example pairing note); on divergence the BOX's values win at settlement.
# Dormant-guardian anti-churn cancel fee, percent (monolith default 0 = full
# refund back; legacy env name BACKSTOP_CANCEL_FEE_PCT also honored):
GUARDIAN_CANCEL_FEE_PCT=0
# Dust floor: refunds below this are retained by escrow, exactly like the
# monolith broadcastRefund's 'skipped' path:
MIN_REFUND=0.05

# ── Optional ─────────────────────────────────────────────────────────────────
# Fee account for single-payment splits (claim settlement never pays a fee; the
# consumed portion simply stays in the escrow account). Leave empty.
FEE_ACCOUNT=

# Durable ledger + the box's own reporting key (schnorr). Under ./data by
# default so a `docker compose down` keeps them; back up the ledger like money.
#ESCROW_DB_PATH=./data/ipfs-gate-escrow.db
#ESCROW_KEY_PATH=./data/escrow-reporting-key.json

# Hive RPC override (blank = escrow-core's hardened fallback list):
#HIVE_API=
